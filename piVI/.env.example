# Chave da YouTube Data API v3 (console.cloud.google.com).
# Sem ela a API serve apenas as faixas ja presentes em youtube_map.json.
YOUTUBE_API_KEY=

# Busca ao vivo para faixas fora do mapa. Custa 100 unidades de quota por
# faixa, contra um teto diario de 10.000. Deixe false em demo.
YOUTUBE_LIVE_FALLBACK=false

# --- Bucket S3 das capas de playlist (nest-api) ---
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefixo das chaves dentro do bucket.
S3_KEY_PREFIX=playlists
# Endpoint alternativo compativel com S3 (MinIO, R2). Vazio = AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Base da URL publica (CloudFront, por exemplo). Vazio = URL padrao da AWS.
S3_PUBLIC_BASE_URL=
